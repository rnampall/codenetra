# Copy to .env and fill in.

# Your GitLab instance. Use https://gitlab.com for SaaS, or your self-hosted URL.
GITLAB_URL=https://gitlab.com

# A token with read_api + read_repository scopes.
# Recommended: a Group Access Token (Settings -> Access Tokens on the group).
# Falls back to a Personal Access Token if you don't have group admin rights.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
